# PostgreSQL 연결 문자열 (Neon, Supabase, Railway 등에서 발급받은 값을 넣으세요)
DATABASE_URL="postgresql://user:password@host:5432/voxbook?sslmode=require"

# JWT 서명 키 — openssl rand -hex 32 등으로 무작위 값 생성해서 넣으세요
JWT_SECRET="change-me-to-a-long-random-string"

# Google Gemini API 키 (https://aistudio.google.com/apikey 에서 무료 발급)
# 더 이상 브라우저에 저장하지 않고 서버에서만 사용합니다.
GEMINI_API_KEY="AIza..."

# 프론트엔드 배포 주소 (CORS 허용용). 로컬 개발 중엔 비워두면 전체 허용.
FRONTEND_ORIGIN="http://localhost:5173"

PORT=4000
